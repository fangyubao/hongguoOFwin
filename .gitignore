# Local machine and IDE files
.DS_Store
.idea/
*.iml
local.properties

# Build and dependency output
.gradle/
.kotlin/
build/
dist/
node_modules/
.venv/
__pycache__/
*.py[cod]
*.apk
*.aab

# Local credentials and signing material
.env
.env.*
!.env.example
*.jks
*.keystore
keystore.properties

# Local captures and downloaded media
/captures/
/downloads/
/tmp/

# Delivery artifacts, native intermediates, local runtime
/outputs/
/server/.local/
.cxx/
.externalNativeBuild/
/ios/Pods/
/ios/build/

# 桌面端构建缓存与本地运行数据（统一放 F 盘，避免占用系统盘）
/.tmp/
/.npmcache/
/.electron-cache/
/.eb-cache/
/.runtime/
/.edge-tmp/
/.edge-cdp/
/desktop/node_modules/
/desktop/server/
/desktop/data/
/desktop/dist/

# 运行时数据：本地索引、设备标识、临时截图（都由程序或脚本自动生成）
/data/
/server/.device.json
shot*.png

# desktop/build 是打包资源（图标生成脚本 + ico/png），不能跟着 build/ 一起忽略
!/desktop/build/
